{
  "name": "buisnes-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "setup": "node scripts/setup.mjs",
    "dev:db": "docker compose up -d db",
    "dev:api": "cargo run --manifest-path backend/Cargo.toml",
    "dev:web": "vite",
    "dev:all": "npm run dev:db && concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "check": "tsc --noEmit && cargo check --manifest-path backend/Cargo.toml",
    "fmt": "cargo fmt --manifest-path backend/Cargo.toml"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.5.0",
    "bpmn-visualization": "^0.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
