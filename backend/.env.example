# Локальный PostgreSQL из docker-compose.yml в корне проекта
DATABASE_URL=postgres://bb:bb@localhost:5432/buisnes_board
BIND_ADDR=127.0.0.1:8080
RUST_LOG=bb_backend=debug,tower_http=info
# За HTTPS поставьте true: cookie получит флаг Secure
COOKIE_SECURE=false
# false отключает самостоятельную регистрацию
ALLOW_REGISTRATION=true
# Каталог со сборкой фронтенда (npm run build → dist): сервер отдаст её сам
FRONTEND_DIR=../dist
# Ключ шифрования подключённых сервисов (Codex): openssl rand -hex 32. Без него подключение отключено.
SECRETS_KEY=
