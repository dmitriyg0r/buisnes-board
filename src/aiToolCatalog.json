        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "edit_bpmn",
      "description": "Редактировать процесс теми же функциями, что и редактор BPMN: все символы палитры, дорожки, пулы, связи, геометрия, подписи, удаление. У add_node/add_region/add_pool/connect можно задать key и далее обращаться к созданному элементу как $key. add_node требует type,x,y; rename — id,name; move — id,x,y; resize — id,width,height; connect — from,to,type; set_region_rows — id,count; edit_edge — id,from,to,points; set_label_bounds — id,x,y,width,height; remove/reset_edge — id.",
      "parameters": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "add_node",
                    "add_region",
                    "add_pool",
                    "rename",
                    "move_node",
                    "resize_node",
                    "move_region",
                    "resize_region",
                    "set_region_rows",
                    "connect",
                    "edit_edge",
                    "reset_edge",
                    "set_label_bounds",
                    "remove"
                  ]
                },
                "key": {
                  "type": "string",
                  "maxLength": 40
                },
                "id": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "maxLength": 500
                },
                "x": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "y": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10000
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10000
                },
                "count": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 20
                },
                "from": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100,
                  "minItems": 2
                }
              },
              "required": [
                "op"
              ],
              "additionalProperties": false
            },
            "maxItems": 120,
            "minItems": 1
          }
        },
        "required": [
          "processId",
          "operations"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "edit_model",
      "description": "Редактировать EPC/UML существующим адаптером, сохраняя ID. modelId — model:<id> или $key. Общие операции: add_node(type,x,y,key), rename(id,name), move_node(id,x,y), resize_node(id,width,height), connect(from,to,type,key), edit_edge(id,from,to,points), reset_edge(id), remove(id). UML-классы: set_compartments(id,attributes,operations), set_edge_ends(id,ends). UML Sequence: add_message(from,to,y,type,key), move_message(id,sendY,receiveY), edit_message(id,from/to/type). Названия задавай rename. Доступные операции и типы читай в read_canvas; сообщения читай в read_object. Результат содержит актуальную диаграмму и замечания проверки; наличие замечаний не означает готовность модели.",
      "parameters": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "add_node",
                    "rename",
                    "move_node",
                    "resize_node",
                    "connect",
                    "edit_edge",
                    "reset_edge",
                    "remove",
                    "set_label_bounds",
                    "set_compartments",
                    "set_edge_ends",
                    "add_message",
                    "move_message",
                    "edit_message"
                  ]
                },
                "key": {
                  "type": "string",
                  "maxLength": 40
                },
                "id": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "maxLength": 500
                },
                "x": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "y": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10000
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10000
                },
                "from": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100,
                  "minItems": 2
                },
                "attributes": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "operations": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "ends": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "role",
                        "multiplicity"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "multiplicity": {
                          "type": "string",
                          "maxLength": 500
                        }
                      }
                    },
                    "to": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "role",
                        "multiplicity"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "multiplicity": {
                          "type": "string",
                          "maxLength": 500
                        }
                      }
                    }
                  }
                },
                "sendY": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "receiveY": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                }
              },
              "required": [
                "op"
              ],
              "additionalProperties": false
            },
            "maxItems": 120,
            "minItems": 1
          },
          "modelId": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1
          }
        },
        "required": [
          "modelId",
          "operations"
        ],
