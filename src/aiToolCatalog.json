                  "maximum": 1000000
                },
                "width": {
                  "type": "number",
                  "minimum": 96,
                  "maximum": 2400
                },
                "height": {
                  "type": "number",
                  "minimum": 96,
                  "maximum": 2400
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            "maxItems": 100,
            "minItems": 1
          }
        },
        "required": [
          "objects"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "set_properties",
      "description": "Изменить атрибуты карточки, узла BPMN или пункта документа. Имена полей бери из read_canvas.propertyFields. null удаляет атрибут. Для узла id=processId:elementId, для карточки proc:/doc:/html:/src:.",
      "parameters": {
        "type": "object",
        "properties": {
          "targetType": {
            "type": "string",
            "enum": [
              "card",
              "node",
              "section"
            ]
          },
          "id": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1
          },
          "values": {
            "type": "object",
            "maxProperties": 30,
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8000
            }
          }
        },
        "required": [
          "targetType",
          "id",
          "values"
        ],
        "additionalProperties": false
      }
    },
    {
