{
  "version": 1,
  "tools": [
    {
      "name": "read_canvas",
      "description": "Прочитать актуальный обзор канваса: объекты, связи, свойства, замечания, выделение, вид и доступные символы BPMN. При truncated=true продолжай с nextOffset; limit задаёт число записей (по умолчанию 40). Также возвращает EPC/UML, палитры, операции и возможности каждой нотации.",
      "parameters": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "read_object",
      "description": "Прочитать объект полностью или частями. Для процесса возвращает XML и подробную диаграмму с ID узлов, дорожек и связей. offset — смещение в тексте; продолжай чтение, пока truncated=true. Для EPC/UML возвращает notation, исходный source, диаграмму, сообщения timeline и замечания проверки.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1
          },
          "offset": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "limit": {
            "type": "number",
            "minimum": 100,
            "maximum": 20000
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_issue",
      "description": "Прочитать полное замечание: вопрос, ответ, решение, привязки и историю статусов.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_html_test",
      "description": "Проверить HTML в отдельном sandbox с той же политикой, что на доске. Заполняет поля, нажимает кнопки и сравнивает результат; исходный объект и его состояние на доске не меняет. Обязателен после создания или изменения HTML перед итоговым ответом. Нужна хотя бы одна expect_text/expect_value; для калькулятора проверь конкретные числа. Выполняется отдельным шагом чтения.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "selector"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "fill",
                    "click",
                    "expect_text",
                    "expect_value"
                  ]
                },
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "value": {
                  "type": "string",
                  "maxLength": 2000
                },
                "text": {
                  "type": "string",
                  "maxLength": 2000
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "create_object",
      "description": "Создать объект любого типа на канвасе. Укажи уникальный key действия. HTML — полный автономный код с inline CSS/JS; без внешних ресурсов. Для пустого процесса XML не нужен. Для документа пункты образуются из Markdown-заголовков. Для EPC/UML: kind=model, notation из read_canvas; source необязателен, пустая модель создаётся адаптером. Далее edit_model.",
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "process",
              "document",
              "html",
              "source",
              "gateway",
              "model"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "markdown": {
            "type": "string",
            "maxLength": 120000
          },
          "html": {
            "type": "string",
            "maxLength": 120000
          },
          "xml": {
            "type": "string",
            "maxLength": 200000
          },
          "ext": {
            "type": "string",
            "enum": [
              "PDF",
              "DOCX"
            ]
          },
          "pages": {
            "type": "number",
            "minimum": 1,
            "maximum": 100000
          },
          "sectionMode": {
            "type": "string",
            "enum": [
              "reference",
              "process"
            ]
          },
          "notation": {
            "type": "string",
            "enum": [
              "epc",
              "uml-class",
              "uml-use-case",
              "uml-activity",
              "uml-sequence"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "required": [
          "kind",
          "title"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_object",
      "description": "Изменить существующий объект: название, полный Markdown/HTML/XML, источник или подпись шлюза. append дописывает Markdown. XML целиком заменяй только по явной просьбе заменить/импортировать схему; обычные правки BPMN делай edit_bpmn. Для EPC/UML source целиком допустим только для явной замены/импорта; обычные правки — edit_model. Нотация существующей модели не меняется.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "markdown": {
            "type": "string",
            "maxLength": 120000
          },
          "html": {
            "type": "string",
            "maxLength": 120000
          },
          "xml": {
            "type": "string",
            "maxLength": 200000
          },
          "ext": {
            "type": "string",
            "enum": [
              "PDF",
              "DOCX"
            ]
          },
          "pages": {
            "type": "number",
            "minimum": 1,
            "maximum": 100000
          },
          "sectionMode": {
            "type": "string",
            "enum": [
              "reference",
              "process"
            ]
          },
          "append": {
            "type": "string",
            "maxLength": 120000
          },
          "source": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delete_objects",
      "description": "Удалить перечисленные карточки вместе с относящимися к ним связями и атрибутами. Изменение отменяется историей доски.",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240,
              "minLength": 1
            },
            "maxItems": 100,
            "minItems": 1
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "set_layout",
      "description": "Переместить или изменить размер карточек. Координаты в системе канваса, не экрана; x/y и width/height указывай парами.",
      "parameters": {
        "type": "object",
        "properties": {
          "objects": {
            "type": "array",
